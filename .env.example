# Webex Bot Token (z developer.webex.com)
BOT_TOKEN=your-webex-bot-token-here

# Email administrátora, kterému chodí notifikace a kterému se nasdílí Google Tabulka
ADMIN_EMAIL=admin@example.com

# ID existující Google tabulky (volitelné - pokud se nevyplní, bot vytvoří novou automaticky)
SPREADSHEET_ID=

# Název tabulky (pokud se vytváří nová)
SPREADSHEET_NAME=Webex Ponožky - Objednávky a Nabídka

# Cesta k JSON klíči Service Accountu pro Google Sheets (na Google Cloud Functions není potřeba, použije se výchozí účet)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Nebo celý JSON klíč v proměnné prostředí (vhodné pro Cloud Secrets / Env vars)
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# Volitelné URL banneru pro Adaptive Card
BANNER_URL=https://images.unsplash.com/photo-1586350977771-b3b0abd50c82?w=800&auto=format&fit=crop&q=80
